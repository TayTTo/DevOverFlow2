# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (database name "devflow" is set in code)
MONGODB_URI=

# Better Auth: random secret (e.g. `openssl rand -base64 32`) and app URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth providers: each is enabled only when both keys are set.
# GitHub callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
